@model List<firstASP.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<a asp-action="Index" class="btn btn-primary mb-3">+ Add Product</a>
<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>
<table class="table table-bordered">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Price</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>