@model List<firstASP.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>
@* Live search: no button, it filters while you type *@
<input type="text" id="searchBox" class="form-control mb-3"
       placeholder="Search product name..." />
<table class="table table-bordered">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Price</th><th>Actions</th></tr>
    </thead>
    <tbody id="productRows">
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
    // Runs every time a key is typed in the search box
    document.getElementById("searchBox").addEventListener("input", function () {
        // What the user typed, in lowercase so "PAPER" matches "Paper"
        const text = this.value.toLowerCase();

        // Look at every row in the table
        document.querySelectorAll("#productRows tr").forEach(function (row) {
            // The Name is the 2nd cell in each row
            const name = row.cells[1].textContent.toLowerCase();

            // Show the row if the name contains the text, hide it if not
            row.style.display = name.includes(text) ? "" : "none";
        });
    });
</script>
}
